{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trailer script",
  "description": "Beat sheet for a product trailer. Feed as Remotion defaultProps. All times in seconds.",
  "type": "object",
  "required": [
    "feature",
    "shape",
    "theme",
    "fps",
    "scenes"
  ],
  "properties": {
    "feature": {
      "type": "string"
    },
    "shape": {
      "enum": [
        "before-after",
        "problem-widen",
        "cold-open",
        "one-number",
        "walkthrough"
      ]
    },
    "theme": {
      "enum": [
        "dark",
        "light"
      ]
    },
    "accent": {
      "type": "string",
      "description": "Secondary accent hex, optional. Pink is always primary.",
      "default": ""
    },
    "fps": {
      "type": "integer",
      "default": 30
    },
    "music": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "bpm": {
          "type": "number"
        },
        "offset": {
          "type": "number",
          "description": "seconds from file start to first downbeat"
        },
        "trimBefore": {
          "type": "number",
          "description": "seconds trimmed from the start so the drop lands on the reveal hit (scripts/find-drop.sh)"
        },
        "dropAt": {
          "type": "number",
          "description": "seconds into the source file where the drop lands"
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "beat",
          "duration",
          "layout"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "beat": {
            "enum": [
              "intro",
              "pain",
              "reveal",
              "demo",
              "payoff",
              "outro"
            ]
          },
          "duration": {
            "type": "number"
          },
          "layout": {
            "enum": [
              "logo-sting",
              "hero-center",
              "hero-left",
              "footage-card",
              "footage-full",
              "footage-zoom",
              "split",
              "code-reveal",
              "label-footage",
              "counter",
              "stack",
              "end-card"
            ]
          },
          "headline": {
            "type": "string"
          },
          "line": {
            "type": "string"
          },
          "footage": {
            "type": "string",
            "description": "public/ path"
          },
          "trimBefore": {
            "type": "number",
            "description": "seconds"
          },
          "playbackRate": {
            "type": "number",
            "default": 1
          },
          "code": {
            "type": "string"
          },
          "highlightLines": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "counter": {
            "type": "object",
            "properties": {
              "from": {
                "type": "number"
              },
              "to": {
                "type": "number"
              },
              "suffix": {
                "type": "string"
              }
            }
          },
          "transitionIn": {
            "enum": [
              "cut",
              "fade",
              "dip",
              "push",
              "slide",
              "wipe",
              "iris",
              "zoom-through",
              "mask",
              "whip",
              "scale-blur",
              "match"
            ]
          },
          "sfx": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "number"
                },
                "file": {
                  "type": "string"
                },
                "gain": {
                  "type": "number"
                }
              }
            }
          },
          "voice": {
            "type": "object",
            "description": "One spoken line for this scene",
            "properties": {
              "text": {
                "type": "string",
                "description": "4-14 words, spoken English"
              },
              "file": {
                "type": "string",
                "description": "public/ path of the chosen take, e.g. audio/voice/03-reveal.mp3"
              },
              "seconds": {
                "type": "number",
                "description": "measured by scripts/voice-timeline.ts"
              },
              "start": {
                "type": "integer",
                "description": "absolute start frame, computed"
              },
              "leadFrames": {
                "type": "integer",
                "description": "override the lead-in after the cut (default 8, 15 after big transitions)"
              },
              "offsetFrames": {
                "type": "integer",
                "description": "shift the line; negative starts it before the cut (\"Introducing...\" over the zoom into the reveal)"
              }
            }
          },
          "transitionFrames": {
            "type": "integer",
            "description": "override the transition length in frames (defaults come from the table in voice-timeline.ts / src/script.ts)"
          },
          "zoomKeys": {
            "type": "array",
            "description": "footage framing. One entry per shot: the camera does not move inside a shot",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "number"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "scale": {
                  "type": "number"
                }
              }
            }
          },
          "clickPoints": {
            "type": "array",
            "description": "click-ring callouts in composition seconds and 0-1 footage coordinates, from <take>.events.json",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "number"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            }
          },
          "clicks": {
            "type": "array",
            "description": "composition seconds of footage clicks for click SFX (muted automatically under voice)",
            "items": {
              "type": "number"
            }
          },
          "glitchAt": {
            "type": "array",
            "description": "composition seconds of glitch flickers, pain footage only",
            "items": {
              "type": "number"
            }
          },
          "pain": {
            "type": "boolean",
            "description": "desaturate and vignette the footage (the old way)"
          }
        }
      }
    },
    "narration": {
      "type": "boolean",
      "default": true
    },
    "voiceId": {
      "type": "string",
      "description": "ElevenLabs voice_id from elevenlabs__creative_list_voices"
    },
    "voiceFlowId": {
      "type": "string",
      "description": "ElevenLabs flow_id that holds all takes"
    },
    "voiceWindows": {
      "type": "array",
      "description": "Written by scripts/voice-timeline.ts. Merged frame ranges where voice plays; music ducks here",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "integer"
          },
          "to": {
            "type": "integer"
          }
        }
      }
    }
  }
}
